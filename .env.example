# Скопируй в .env.local (локально) или в Vercel → Settings → Environment Variables
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (токен бота из @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Payme (merchant id публичный, key — секрет)
NEXT_PUBLIC_PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# Click
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
